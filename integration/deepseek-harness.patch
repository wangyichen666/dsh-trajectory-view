@@ -0,0 +1,56 @@
+/** Session-specific launcher for the separate trajectory explorer. */
+import { useEffect, useState } from 'react'
+import type { ConvViewProps } from '@deepseek-ai/dsh-client-ui-conversation/client'
+import type { PropsLocale } from '@deepseek-ai/dsh-client-ui-slots'
+import type { SessionId } from '@deepseek-ai/dsh-session/types'
+import css from './AnalysisView.module.css'
+
+/** Values supplied by the conversation view registration. */
+export interface AnalysisViewInjected {
+  sessionId: SessionId
+  explorerOrigin: string
+}
+
+type AnalysisViewProps = ConvViewProps & AnalysisViewInjected & PropsLocale<'trajectory'>
+
+/** Opens the current Session in the local analysis service. */
+export function AnalysisView({ sessionId, explorerOrigin, t }: AnalysisViewProps) {
+  const [launchUrl, setLaunchUrl] = useState<string | null>(null)
+  const [error, setError] = useState(false)
+
+  useEffect(() => {
+    const controller = new AbortController()
+    setLaunchUrl(null)
+    setError(false)
+    void (async () => {
+      try {
+        const origin = new URL(explorerOrigin)
+        const response = await fetch(new URL('/api/launch-info', origin), { signal: controller.signal })
+        if (!response.ok) throw new Error(`HTTP ${response.status}`)
+        const payload: { url?: string } = await response.json()
+        if (typeof payload.url !== 'string') throw new Error('Missing launch URL')
+        const target = new URL(payload.url)
+        if (target.origin !== origin.origin) throw new Error('Unexpected analysis origin')
+        target.searchParams.set('session', sessionId)
+        if (!controller.signal.aborted) setLaunchUrl(target.href)
+      } catch {
+        if (!controller.signal.aborted) setError(true)
+      }
+    })()
+    return () => controller.abort()
+  }, [explorerOrigin, sessionId])
+
+  return <main className={css.root}>
+    <section className={css.card} aria-label={t('analysisPage.title')}>
+      <h2 className={css.title}>{t('analysisPage.title')}</h2>
+      <p className={css.description}>{t('analysisPage.description')}</p>
+      <code className={css.session}>{sessionId}</code>
+      <button className={css.button} type="button" disabled={launchUrl === null}
+        onClick={() => { if (launchUrl !== null) window.open(launchUrl, '_blank', 'noopener,noreferrer') }}>
+        {t('analysisPage.open')}
+      </button>
+      {error && <p className={css.status} role="status">{t('analysisPage.unavailable')}</p>}
+      {!error && launchUrl === null && <p className={css.status} role="status">{t('analysisPage.connecting')}</p>}
+    </section>
+  </main>
+}
diff --git a/packages/client/ui-trajectory/src/client/request-analysis.ts b/packages/client/ui-trajectory/src/client/request-analysis.ts
