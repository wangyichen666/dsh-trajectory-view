+/** Address of the local, read-only session analysis service. */
+import z from '@deepseek-ai/schemastery'
+
+/** Browser trajectory plugin settings. */
+export interface Config {
+  /** Origin of the local session analysis service. */
+  explorerOrigin: string
+}
+
+/** Validated browser trajectory plugin settings. */
+export const Config: z<Partial<Config>, Config> = z.object({
+  explorerOrigin: z.string().pattern(/^http:\/\/127\.0\.0\.1:[1-9]\d{0,4}$/u).default('http://127.0.0.1:3091'),
+})
diff --git a/packages/client/ui-trajectory/tests/request-analysis.client.spec.ts b/packages/client/ui-trajectory/tests/request-analysis.client.spec.ts
new file mode 100644
index 0000000000..9459033218
--- /dev/null
+++ b/packages/client/ui-trajectory/tests/request-analysis.client.spec.ts
@@ -0,0 +1,96 @@
+import { describe, expect, it } from 'vitest'
+import { createMessage, createToolResultMessage, createUserMessage, ToolCallId } from '@deepseek-ai/dsh-llm'
+import { Session, SessionId } from '@deepseek-ai/dsh-session'
+import { analyzeRequest } from '../src/client/request-analysis.ts'
+
+function assistant(text: string) {
+  return createMessage({
+    role: 'assistant',
+    content: [{ type: 'text', text }],
+    source: { kind: 'model', provider: 'mock', model: 'test' },
+  })
+}
+
+describe('trajectory request analysis', () => {
+  it('reconstructs the message prefix before the selected response and preserves tool I/O', () => {
+    const session = Session.create(SessionId('analysis'))
+    session.append('turn/start', { turn: 1 })
+    session.append('step/start', { turn: 1, step: 1 })
+    session.append('request/header', {
+      header: { config: { provider: 'mock', model: 'test' } }, reason: 'initial',
+    })
+    session.append('user/message', createUserMessage({
+      content: [{ type: 'text', text: 'first' }], source: { kind: 'user' },
+    }), { surfaceOp: 'append' })
+    session.append('assistant/message', {
+      turn: 1, step: 1, message: assistant('response one'), stream: [],
+    }, { surfaceOp: 'append' })
+    session.append('step/end', { turn: 1, step: 1 })
+    session.append('step/start', { turn: 1, step: 2 })
+    session.append('user/message', createUserMessage({
+      content: [{ type: 'text', text: 'second' }], source: { kind: 'user' },
+    }), { surfaceOp: 'append' })
+    session.append('assistant/message', {
+      turn: 1, step: 2, message: assistant('response two'), stream: [],
+    }, { surfaceOp: 'append' })
+    const callId = ToolCallId('call-1')
+    session.append('tool/call', { turn: 1, step: 2, callId, name: 'echo', arguments: '{ "text": "hello" }' })
+    session.append('tool/result', {
+      turn: 1, step: 2,
+      message: createToolResultMessage({
+        callId, content: [{ type: 'text', text: 'hello' }], isError: false,
+      }),
+    }, { surfaceOp: 'append' })
+    session.append('step/end', { turn: 1, step: 2 })
+
+    const analysis = analyzeRequest(session.snapshotEvents(), 1, 2)
+    expect(analysis.state).toBe('ready')
+    expect(analysis.header?.config.model).toBe('test')
+    expect(analysis.messages?.map(item => item.message.role)).toEqual(['user', 'assistant', 'user'])
+    expect(JSON.stringify(analysis.messages)).not.toContain('response two')
+    expect(analysis.response?.message.content).toEqual([{ type: 'text', text: 'response two' }])
+    expect(analysis.tools).toMatchObject([{ name: 'echo', arguments: '{ "text": "hello" }' }])
+    expect(analysis.tools[0]?.result?.content).toEqual([{ type: 'text', text: 'hello' }])
+  })
+
+  it('does not claim a complete prompt when the event window omits its prefix', () => {
+    const session = Session.create(SessionId('analysis-window'))
+    session.append('turn/start', { turn: 1 })
+    session.append('step/start', { turn: 1, step: 1 })
+    session.append('user/message', createUserMessage({
+      content: [{ type: 'text', text: 'hello' }], source: { kind: 'user' },
+    }), { surfaceOp: 'append' })
+    session.append('assistant/message', {
+      turn: 1, step: 1, message: assistant('hi'), stream: [],
+    }, { surfaceOp: 'append' })
+    const analysis = analyzeRequest(session.snapshotEvents().slice(1), 1, 1)
+    expect(analysis.state).toBe('history-incomplete')
+    expect(analysis.messages).toBeUndefined()
+    expect(analysis.response?.message.content).toEqual([{ type: 'text', text: 'hi' }])
+  })
+
+  it('pairs a successful retry with its final request header', () => {
+    const session = Session.create(SessionId('analysis-retry'))
+    session.append('turn/start', { turn: 1 })
+    session.append('step/start', { turn: 1, step: 1 })
+    session.append('request/header', {
+      header: { config: { provider: 'mock', model: 'first' } }, reason: 'initial',
+    })
+    session.append('user/message', createUserMessage({
+      content: [{ type: 'text', text: 'hello' }], source: { kind: 'user' },
+    }), { surfaceOp: 'append' })
+    session.append('assistant/attempt', { turn: 1, step: 1, stream: [] })
+    session.append('request/header', {
+      header: { config: { provider: 'mock', model: 'second' } }, reason: 'change',
+    })
+    session.append('assistant/message', {
+      turn: 1, step: 1, message: assistant('done'), stream: [],
+    }, { surfaceOp: 'append' })
+
+    const analysis = analyzeRequest(session.snapshotEvents(), 1, 1)
+    expect(analysis.header?.config.model).toBe('second')
+    expect(analysis.messages?.map(item => item.message.role)).toEqual(['user'])
+    expect(analysis.attempts).toHaveLength(1)
+    expect(analysis.response?.message.content).toEqual([{ type: 'text', text: 'done' }])
+  })
+})
