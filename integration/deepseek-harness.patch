index 0000000000..345600b14e
--- /dev/null
+++ b/packages/client/ui-trajectory/src/client/request-analysis.ts
@@ -0,0 +1,157 @@
+/** Reconstruct one request's logged inputs and outputs at its dispatch boundary. */
+
+import type { Message } from '@deepseek-ai/dsh-llm/types'
+import { deriveEventMessage, foldSurface } from '@deepseek-ai/dsh-session/surface'
+import type { EpochHeader, SessionEvent } from '@deepseek-ai/dsh-session/types'
+import { currentSessionMessageProjections } from '@deepseek-ai/dsh-session-format-catalog/message-projections'
+
+type AssistantEvent = SessionEvent<'assistant/message'>
+type AttemptEvent = SessionEvent<'assistant/attempt'>
+type ToolResultEvent = SessionEvent<'tool/result'>
+
+/** A model-visible message and the durable event that contributed it. */
+export interface RequestAnalysisMessage {
+  readonly seq: number
+  readonly eventType: string
+  readonly message: Message
+}
+
+/** One raw tool call with its model-facing result, when settled. */
+export interface RequestAnalysisTool {
+  readonly seq: number
+  readonly name: string
+  readonly callId: string
+  readonly arguments: string
+  readonly result?: ToolResultEvent['data']['message']
+  readonly error?: ToolResultEvent['data']['error']
+}
+
+/** Child creation recorded by the parent during this step. */
+export interface RequestAnalysisChild {
+  readonly seq: number
+  readonly id: string
+  readonly mode: string
+  readonly label?: string
+}
+
+/** Logged request view. `messages` is absent until the complete prefix is loaded. */
+export interface RequestAnalysis {
+  readonly state: 'ready' | 'history-incomplete' | 'step-not-found' | 'invalid-surface'
+  readonly error?: string
+  readonly boundarySeq?: number
+  readonly confirmed: boolean
+  readonly header?: EpochHeader
+  readonly messages?: readonly RequestAnalysisMessage[]
+  readonly attempts: readonly { seq: number; stream: AttemptEvent['data']['stream'] }[]
+  readonly response?: { seq: number; message: AssistantEvent['data']['message']; stream: AssistantEvent['data']['stream'] }
+  readonly tools: readonly RequestAnalysisTool[]
+  readonly children: readonly RequestAnalysisChild[]
+}
+
+function record(value: unknown): Record<string, unknown> | null {
+  return typeof value === 'object' && value !== null && !Array.isArray(value)
+    ? value as Record<string, unknown>
+    : null
+}
+
+function childOf(event: SessionEvent): RequestAnalysisChild | null {
+  const type: string = event.type
+  if (type !== 'subagent/catalog') return null
+  const data: unknown = event.data
+  const value = record(data)
+  if (value === null || typeof value['childId'] !== 'string' || typeof value['mode'] !== 'string') return null
+  return {
+    seq: event.seq,
+    id: value['childId'],
+    mode: value['mode'],
+    ...(typeof value['label'] === 'string' ? { label: value['label'] } : {}),
+  }
+}
+
+/**
+ * Rebuild the logical model request from the complete log prefix preceding
+ * the final Assistant settlement of a step. On retries this pairs the prompt
+ * with the committed response. The adapter's HTTP wire
+ * serialization is outside the Session log and is not represented here.
+ * @param events - Contiguous durable window in session sequence order.
+ * @param turn - Requested turn.
+ * @param step - Requested step.
+ * @returns Logged request input, normalized response, tools, and child facts.
+ */
+export function analyzeRequest(
+  events: readonly SessionEvent[],
+  turn: number,
+  step: number,
+): RequestAnalysis {
+  const empty = { confirmed: false, attempts: [], tools: [], children: [] } as const
+  const startIndex = events.findIndex(event => event.type === 'step/start'
+    && event.data.turn === turn && event.data.step === step)
+  if (startIndex < 0) return { ...empty, state: 'step-not-found' }
+  const endOffset = events.slice(startIndex + 1).findIndex(event => event.type === 'step/end'
+    && event.data.turn === turn && event.data.step === step)
+  const endIndex = endOffset < 0 ? events.length : startIndex + 1 + endOffset
+  const stepEvents = events.slice(startIndex + 1, endIndex)
+  const settlementOffset = stepEvents.findLastIndex(event => event.type === 'assistant/attempt'
+    || event.type === 'assistant/message')
+  const boundaryIndex = settlementOffset < 0 ? endIndex : startIndex + 1 + settlementOffset
+  const boundarySeq = events[boundaryIndex]?.seq ?? (events.at(-1)?.seq ?? -1) + 1
+  const attempts = stepEvents.flatMap(event => event.type === 'assistant/attempt'
+    ? [{ seq: event.seq, stream: event.data.stream }]
+    : [])
+  const response = stepEvents.find((event): event is AssistantEvent => event.type === 'assistant/message')
+  const results = new Map(stepEvents.flatMap(event => event.type === 'tool/result'
+    ? [[String(event.data.message.toolCallId), event] as const]
+    : []))
+  const tools = stepEvents.flatMap((event): RequestAnalysisTool[] => {
+    if (event.type !== 'tool/call') return []
+    const result = results.get(String(event.data.callId))
+    return [{
+      seq: event.seq,
+      name: event.data.name,
+      callId: String(event.data.callId),
+      arguments: event.data.arguments,
+      ...(result === undefined ? {} : { result: result.data.message }),
+      ...(result?.data.error === undefined ? {} : { error: result.data.error }),
+    }]
+  })
+  const children = stepEvents.flatMap(event => {
+    const child = childOf(event)
+    return child === null ? [] : [child]
+  })
+  const common = {
+    boundarySeq,
+    confirmed: settlementOffset >= 0,
+    attempts,
+    ...(response === undefined ? {} : {
+      response: { seq: response.seq, message: response.data.message, stream: response.data.stream },
+    }),
+    tools,
+    children,
+  }
+  if (events[0]?.seq !== 0 || events.slice(0, boundaryIndex).some((event, index) => event.seq !== index)) {
+    return { ...common, state: 'history-incomplete' }
+  }
+  const prefix = events.slice(0, boundaryIndex)
+  const header = prefix.findLast((event): event is SessionEvent<'request/header'> => event.type === 'request/header')
+  try {
+    const folded = foldSurface(prefix, currentSessionMessageProjections)
+    const messages = folded.nodes.flatMap((seq): RequestAnalysisMessage[] => {
+      const event = prefix[seq]
+      if (event === undefined) return []
+      const message = deriveEventMessage(event, folded.projectedMessages)
+      return message === null ? [] : [{ seq, eventType: event.type, message }]
+    })
+    return {
+      ...common,
+      state: 'ready',
+      ...(header === undefined ? {} : { header: header.data.header }),
+      messages,
+    }
+  } catch (error: unknown) {
+    return {
+      ...common,
+      state: 'invalid-surface',
+      error: error instanceof Error ? error.message : String(error),
+    }
+  }
+}
